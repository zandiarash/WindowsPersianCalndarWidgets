{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "rtl": true,
  "body": [
    {
      "type": "Container",
      "style": "accent",
      "bleed": true,
      "height": "stretch",
      "verticalContentAlignment": "center",
      "backgroundImage": { "url": "${hero}", "fillMode": "cover", "horizontalAlignment": "center", "verticalAlignment": "center" },
      "items": [
        {
          "type": "ColumnSet",
          "columns": [
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [ { "type": "TextBlock", "text": "${day}", "size": "extraLarge", "weight": "bolder", "color": "light" } ]
            },
            {
              "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [
                { "type": "TextBlock", "text": "${weekday}", "size": "medium", "weight": "bolder", "color": "light" },
                { "type": "TextBlock", "text": "${monthYear}", "color": "light", "spacing": "none" }
              ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center",
              "items": [
                { "type": "TextBlock", "text": "${time}", "size": "large", "weight": "bolder", "color": "light", "horizontalAlignment": "left" },
                { "type": "TextBlock", "text": "${greeting}", "size": "small", "color": "light", "isSubtle": true, "spacing": "none", "horizontalAlignment": "left" }
              ]
            }
          ]
        },
        {
          "type": "ColumnSet", "spacing": "small",
          "columns": [
            { "type": "Column", "width": "stretch", "items": [ { "type": "TextBlock", "text": "${hijri}", "size": "small", "color": "light" } ] },
            { "type": "Column", "width": "auto", "items": [ { "type": "TextBlock", "text": "${gregorian}", "size": "small", "color": "light" } ] }
          ]
        }
      ]
    }
  ]
}
