{
  "type": "AdaptiveCard",
  "$schema": "http://adaptivecards.io/schemas/adaptive-card.json",
  "version": "1.5",
  "rtl": true,
  "body": [
    { "type": "Image", "url": "${hero}", "size": "stretch", "altText": "${alt}" },
    {
      "type": "Container",
      "$data": "${dark}",
      "$when": "${$host.hostTheme == 'dark'}",
      "spacing": "small",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [ { "type": "Image", "url": "${title}", "width": "190px", "height": "40px", "horizontalAlignment": "right", "altText": "ماه" } ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center", "$when": "${$root.isAway}",
              "selectAction": { "type": "Action.Execute", "verb": "today", "tooltip": "امروز" },
              "items": [ { "type": "Image", "url": "${today}", "width": "56px", "height": "28px", "altText": "امروز" } ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center", "spacing": "small",
              "selectAction": { "type": "Action.Execute", "verb": "next", "tooltip": "ماه بعد" },
              "items": [ { "type": "Image", "url": "${next}", "width": "32px", "height": "32px", "altText": "ماه بعد" } ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center", "spacing": "small",
              "selectAction": { "type": "Action.Execute", "verb": "prev", "tooltip": "ماه قبل" },
              "items": [ { "type": "Image", "url": "${prev}", "width": "32px", "height": "32px", "altText": "ماه قبل" } ]
            }
          ]
        },
        { "type": "Image", "url": "${grid}", "size": "stretch", "spacing": "small", "altText": "تقویم ماه" },
        { "type": "Image", "$when": "${exists(next_event)}", "url": "${next_event}", "size": "stretch", "spacing": "small", "altText": "مناسبت پیش رو" }
      ]
    },
    {
      "type": "Container",
      "$data": "${light}",
      "$when": "${$host.hostTheme != 'dark'}",
      "spacing": "small",
      "items": [
        {
          "type": "ColumnSet",
          "spacing": "small",
          "columns": [
            {
              "type": "Column", "width": "stretch", "verticalContentAlignment": "center",
              "items": [ { "type": "Image", "url": "${title}", "width": "190px", "height": "40px", "horizontalAlignment": "right", "altText": "ماه" } ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center", "$when": "${$root.isAway}",
              "selectAction": { "type": "Action.Execute", "verb": "today", "tooltip": "امروز" },
              "items": [ { "type": "Image", "url": "${today}", "width": "56px", "height": "28px", "altText": "امروز" } ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center", "spacing": "small",
              "selectAction": { "type": "Action.Execute", "verb": "next", "tooltip": "ماه بعد" },
              "items": [ { "type": "Image", "url": "${next}", "width": "32px", "height": "32px", "altText": "ماه بعد" } ]
            },
            {
              "type": "Column", "width": "auto", "verticalContentAlignment": "center", "spacing": "small",
              "selectAction": { "type": "Action.Execute", "verb": "prev", "tooltip": "ماه قبل" },
              "items": [ { "type": "Image", "url": "${prev}", "width": "32px", "height": "32px", "altText": "ماه قبل" } ]
            }
          ]
        },
        { "type": "Image", "url": "${grid}", "size": "stretch", "spacing": "small", "altText": "تقویم ماه" },
        { "type": "Image", "$when": "${exists(next_event)}", "url": "${next_event}", "size": "stretch", "spacing": "small", "altText": "مناسبت پیش رو" }
      ]
    }
  ]
}
