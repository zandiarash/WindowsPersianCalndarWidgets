<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Tint laid over the native Windows 11 acrylic backdrop -->
    <SolidColorBrush x:Key="WindowTintBrush" Color="#B0141320" />
    <SolidColorBrush x:Key="SurfaceBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#1AFFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#F4F4FA" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#B9B9C9" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#77778C" />
    <SolidColorBrush x:Key="HolidayBrush" Color="#FF6B7A" />
    <SolidColorBrush x:Key="HolidaySoftBrush" Color="#26FF6B7A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F6232230" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#22FFFFFF" />
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
