<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- Frosted mode: tint laid over the native Windows 11 acrylic backdrop -->
    <SolidColorBrush x:Key="WindowTintBrush" Color="#B0141320" />
    <!-- Normal mode: solid, opaque background -->
    <SolidColorBrush x:Key="SolidBackgroundBrush" Color="#1C1B26" />
    <SolidColorBrush x:Key="SolidSurfaceBrush" Color="#262533" />
    <SolidColorBrush x:Key="SolidSurfaceStrokeBrush" Color="#14FFFFFF" />
    <!-- Glass mode: light smoky tint over the blurred desktop -->
    <SolidColorBrush x:Key="GlassTintBrush" Color="#2E0E0C18" />
    <LinearGradientBrush x:Key="GlassSheenBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Offset="0" Color="#30FFFFFF" />
        <GradientStop Offset="0.4" Color="#0AFFFFFF" />
        <GradientStop Offset="1" Color="#00FFFFFF" />
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="GlassEdgeBrush" StartPoint="0,0" EndPoint="0,1">
        <GradientStop Offset="0" Color="#66FFFFFF" />
        <GradientStop Offset="1" Color="#18FFFFFF" />
    </LinearGradientBrush>
    <SolidColorBrush x:Key="SurfaceBrush" Color="#12FFFFFF" />
    <SolidColorBrush x:Key="SurfaceStrokeBrush" Color="#33FFFFFF" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#FAFAFF" />
    <SolidColorBrush x:Key="TextSecondaryBrush" Color="#CACAD8" />
    <SolidColorBrush x:Key="TextTertiaryBrush" Color="#9C9CB2" />
    <SolidColorBrush x:Key="HolidayBrush" Color="#FF6B7A" />
    <SolidColorBrush x:Key="HolidaySoftBrush" Color="#26FF6B7A" />
    <SolidColorBrush x:Key="HoverBrush" Color="#16FFFFFF" />
    <SolidColorBrush x:Key="PressedBrush" Color="#0CFFFFFF" />
    <SolidColorBrush x:Key="DividerBrush" Color="#14FFFFFF" />
    <SolidColorBrush x:Key="MenuBackgroundBrush" Color="#F6232230" />
    <SolidColorBrush x:Key="MenuBorderBrush" Color="#22FFFFFF" />
    <Color x:Key="ShadowColor">#000000</Color>
</ResourceDictionary>
