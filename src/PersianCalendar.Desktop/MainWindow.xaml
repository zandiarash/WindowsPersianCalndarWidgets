<Window x:Class="PersianCalendar.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:PersianCalendar.Desktop.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="تقویم شمسی"
        Width="380" SizeToContent="Height"
        WindowStyle="None" ResizeMode="NoResize" ShowInTaskbar="False"
        Background="Transparent"
        FontFamily="{StaticResource VazirFont}"
        Foreground="{DynamicResource TextPrimaryBrush}"
        FlowDirection="RightToLeft"
        UseLayoutRounding="True"
        TextOptions.TextRenderingMode="ClearType">

    <!-- Client area covers the whole window; DWM paints the Windows 11 acrylic backdrop behind it -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" GlassFrameThickness="-1" ResizeBorderThickness="0"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Border x:Name="Root" Background="{DynamicResource GlassTintBrush}" Opacity="0">
      <Grid>
        <!-- Glass sheen: soft diagonal light + bright top edge, like a pane of glass catching light -->
        <Border x:Name="Sheen" IsHitTestVisible="False" Background="{DynamicResource GlassSheenBrush}"
                BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1" CornerRadius="8" />
        <StackPanel Margin="12">

            <!-- ================= HERO: today ================= -->
            <Border x:Name="Hero" CornerRadius="18" Background="{DynamicResource HeroBrush}" ClipToBounds="True"
                    BorderBrush="{DynamicResource GlassEdgeBrush}" BorderThickness="1"
                    MouseLeftButtonDown="DragArea_MouseLeftButtonDown" Cursor="SizeAll"
                    ToolTip="برای جابه‌جایی بکشید · راست‌کلیک برای تنظیمات">
                <Grid>
                    <!-- Decorative light orbs -->
                    <Ellipse Width="210" Height="210" Fill="#22FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="-70,-90,0,0" IsHitTestVisible="False" />
                    <Ellipse Width="130" Height="130" Fill="#16FFFFFF" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="70,0,0,-70" IsHitTestVisible="False" />
                    <Ellipse Width="90" Height="90" Fill="#12FFFFFF" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,-40,-30,0" IsHitTestVisible="False" />

                    <Grid Margin="20,16,20,16" TextElement.Foreground="White">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Greeting + weekday | clock -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel VerticalAlignment="Center">
                                <TextBlock Text="{Binding Greeting}" FontSize="12" Opacity="0.85" />
                                <TextBlock Text="{Binding TodayWeekDay}" FontSize="19" FontWeight="Bold" Margin="0,-2,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="1" Orientation="Horizontal" FlowDirection="LeftToRight" VerticalAlignment="Center">
                                <TextBlock Text="{Binding HourMinute}" FontSize="32" FontWeight="Bold" />
                                <TextBlock Text="{Binding Seconds}" FontSize="15" FontWeight="Medium" Opacity="0.7"
                                           VerticalAlignment="Bottom" Margin="5,0,0,8"
                                           Visibility="{Binding ShowSeconds, Converter={StaticResource BoolToVisibility}}" />
                            </StackPanel>
                        </Grid>

                        <!-- Big date | Gregorian & Hijri -->
                        <Grid Grid.Row="1" Margin="0,2,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <TextBlock Text="{Binding TodayDay}" FontSize="76" FontWeight="Black" Margin="0,-14,0,-16">
                                <TextBlock.Effect>
                                    <DropShadowEffect BlurRadius="18" ShadowDepth="2" Direction="270" Opacity="0.25" />
                                </TextBlock.Effect>
                            </TextBlock>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="14,0,0,0">
                                <TextBlock Text="{Binding TodayMonth}" FontSize="24" FontWeight="Bold" />
                                <TextBlock Text="{Binding TodayYear}" FontSize="15" Opacity="0.85" Margin="0,-4,0,0" />
                            </StackPanel>
                            <StackPanel Grid.Column="2" VerticalAlignment="Bottom" Margin="0,0,0,6">
                                <TextBlock Text="{Binding TodayGregorian}" FontFamily="{StaticResource LatinFont}" FontSize="12.5"
                                           FlowDirection="LeftToRight" HorizontalAlignment="Right" Opacity="0.9" />
                                <TextBlock Text="{Binding TodayHijri}" FontSize="12.5" HorizontalAlignment="Right" Opacity="0.9" Margin="0,2,0,0" />
                            </StackPanel>
                        </Grid>

                        <!-- Year progress -->
                        <StackPanel Grid.Row="2" Margin="0,12,0,0">
                            <Grid Height="5">
                                <Border CornerRadius="3" Background="#38FFFFFF" />
                                <Border CornerRadius="3" Background="White" HorizontalAlignment="Left"
                                        Width="{Binding ActualWidth, RelativeSource={RelativeSource AncestorType=Grid}}">
                                    <Border.RenderTransform>
                                        <ScaleTransform x:Name="ProgressScale" ScaleX="{Binding YearProgress}" />
                                    </Border.RenderTransform>
                                </Border>
                            </Grid>
                            <TextBlock Text="{Binding YearProgressText}" FontSize="11.5" Opacity="0.85" Margin="0,6,0,0" />
                        </StackPanel>
                    </Grid>
                </Grid>
            </Border>

            <!-- ================= Month navigation ================= -->
            <Grid Margin="6,14,2,6" Background="Transparent" MouseLeftButtonDown="DragArea_MouseLeftButtonDown">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal">
                        <TextBlock Text="{Binding MonthName}" FontSize="20" FontWeight="Bold" />
                        <TextBlock Text="{Binding MonthYear}" FontSize="20" FontWeight="Light" Margin="6,0,0,0"
                                   Foreground="{DynamicResource TextSecondaryBrush}" />
                        <Border Background="{DynamicResource AccentSoftBrush}" CornerRadius="9" Padding="8,1" Margin="10,2,0,0" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SeasonName}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </StackPanel>
                    <TextBlock Text="{Binding MonthSubtitle}" FontFamily="{StaticResource LatinFont}" FontSize="11.5"
                               Foreground="{DynamicResource TextTertiaryBrush}" HorizontalAlignment="Left" FlowDirection="LeftToRight" />
                </StackPanel>
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource PillButtonStyle}" Content="امروز" Margin="0,0,6,0"
                            Command="{Binding GoToTodayCommand}" ToolTip="بازگشت به امروز (Home)"
                            Visibility="{Binding IsAwayFromToday, Converter={StaticResource BoolToVisibility}}" />
                    <!-- Right-to-left panel: › (next) sits right of ‹ (previous) -->
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76C;" Command="{Binding NextMonthCommand}" ToolTip="ماه بعد" />
                    <Button Style="{StaticResource IconButtonStyle}" Content="&#xE76B;" Command="{Binding PreviousMonthCommand}" ToolTip="ماه قبل" />
                    <Button x:Name="MoreButton" Style="{StaticResource IconButtonStyle}" Content="&#xE712;" Click="MoreButton_Click" ToolTip="تنظیمات" />
                </StackPanel>
            </Grid>

            <!-- ================= Week day headers ================= -->
            <ItemsControl ItemsSource="{Binding WeekDayHeaders}" Margin="0,4,0,0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="7" />
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <TextBlock x:Name="H" Text="{Binding}" HorizontalAlignment="Center" FontSize="12.5" FontWeight="Bold"
                                   Foreground="{DynamicResource TextTertiaryBrush}" />
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding}" Value="ج">
                                <Setter TargetName="H" Property="Foreground" Value="{DynamicResource HolidayBrush}" />
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>

            <!-- ================= Day grid ================= -->
            <Grid x:Name="DaysHost" Margin="0,4,0,0" Background="Transparent" MouseWheel="Days_MouseWheel" ClipToBounds="True">
                <ItemsControl x:Name="DaysList" ItemsSource="{Binding Days}">
                    <ItemsControl.RenderTransform>
                        <TranslateTransform x:Name="DaysTranslate" />
                    </ItemsControl.RenderTransform>
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Columns="7" Rows="6" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:DayCellViewModel}">
                            <Button Style="{StaticResource DayButtonStyle}"
                                    Command="{Binding DataContext.SelectDayCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                    CommandParameter="{Binding}">
                                <Grid>
                                    <TextBlock Text="{Binding GregorianNumber}" FontFamily="{StaticResource LatinFont}" FontSize="9"
                                               Opacity="0.5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,4,6,0"
                                               Visibility="{Binding DataContext.ShowGregorianNumbers, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource BoolToVisibility}}" />
                                    <TextBlock Text="{Binding Number}" FontSize="16" FontWeight="SemiBold"
                                               HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    <Ellipse Width="4" Height="4" VerticalAlignment="Bottom" Margin="0,0,0,5"
                                             Visibility="{Binding HasEvents, Converter={StaticResource BoolToVisibility}}">
                                        <Ellipse.Style>
                                            <Style TargetType="Ellipse">
                                                <Setter Property="Fill" Value="{DynamicResource AccentBrush}" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                                        <Setter Property="Fill" Value="{DynamicResource HolidayBrush}" />
                                                    </DataTrigger>
                                                    <DataTrigger Binding="{Binding IsToday}" Value="True">
                                                        <Setter Property="Fill" Value="White" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Ellipse.Style>
                                    </Ellipse>
                                </Grid>
                            </Button>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>

            <!-- ================= Selected day details ================= -->
            <Border Margin="0,10,0,0" CornerRadius="16" Padding="14,12" Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource SurfaceStrokeBrush}" BorderThickness="1">
                <StackPanel>
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedTitle}" FontSize="14.5" FontWeight="Bold" VerticalAlignment="Center" />
                        <Border Grid.Column="1" CornerRadius="9" Padding="9,1" Background="{DynamicResource AccentSoftBrush}" VerticalAlignment="Center">
                            <TextBlock Text="{Binding SelectedRelative}" FontSize="11" FontWeight="Bold" Foreground="{DynamicResource AccentBrush}" />
                        </Border>
                    </Grid>
                    <Grid Margin="0,3,0,0" TextElement.Foreground="{DynamicResource TextSecondaryBrush}" TextElement.FontSize="11.5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="{Binding SelectedHijri}" />
                        <TextBlock Grid.Column="1" Text="{Binding SelectedGregorian}" FontFamily="{StaticResource LatinFont}"
                                   FlowDirection="LeftToRight" HorizontalAlignment="Right" />
                    </Grid>

                    <!-- Events of the selected day -->
                    <ItemsControl ItemsSource="{Binding SelectedEvents}" Margin="0,6,0,0">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:EventItem}">
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <Border x:Name="Dot" Width="7" Height="7" CornerRadius="4" Background="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                                    <TextBlock x:Name="T" Text="{Binding Title}" FontSize="12.5" Margin="8,0,0,0" TextWrapping="Wrap" MaxWidth="300" />
                                    <Border x:Name="Tag" CornerRadius="6" Padding="6,0" Margin="8,0,0,0" Background="{DynamicResource HolidaySoftBrush}"
                                            Visibility="Collapsed" VerticalAlignment="Center">
                                        <TextBlock Text="تعطیل" FontSize="10" FontWeight="Bold" Foreground="{DynamicResource HolidayBrush}" />
                                    </Border>
                                </StackPanel>
                                <DataTemplate.Triggers>
                                    <DataTrigger Binding="{Binding IsHoliday}" Value="True">
                                        <Setter TargetName="Dot" Property="Background" Value="{DynamicResource HolidayBrush}" />
                                        <Setter TargetName="Tag" Property="Visibility" Value="Visible" />
                                    </DataTrigger>
                                </DataTemplate.Triggers>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>

                    <!-- Next upcoming occasion -->
                    <Border Height="1" Background="{DynamicResource DividerBrush}" Margin="0,10,0,8" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Text="&#xE787;" FontFamily="{StaticResource IconFont}" FontSize="13"
                                   Foreground="{DynamicResource AccentBrush}" VerticalAlignment="Center" />
                        <TextBlock Grid.Column="1" Margin="8,0,8,0" VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                            <Run Text="پیش رو:" Foreground="{DynamicResource TextTertiaryBrush}" FontSize="11.5" />
                            <Run Text="{Binding NextEventTitle, Mode=OneWay}" FontWeight="Bold" FontSize="12" />
                        </TextBlock>
                        <TextBlock Grid.Column="2" Text="{Binding NextEventWhen}" FontSize="11"
                                   Foreground="{DynamicResource TextSecondaryBrush}" VerticalAlignment="Center" />
                    </Grid>
                </StackPanel>
            </Border>
        </StackPanel>
      </Grid>
    </Border>
</Window>
